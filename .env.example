# paytience-backend configuration (docs/protocol.md §3, §5.8). Copy to .env and fill in.
# Empty values count as unset.

# HTTP + WebSocket listen address.
BIND_ADDR=127.0.0.1:8080
# Solana JSON-RPC used to broadcast co-signed transactions (and by the faucet).
SOLANA_RPC=https://api.devnet.solana.com
# JSON-RPC that allows getProgramAccounts, for the per-MM usage scan. Empty uses
# SOLANA_RPC; until a scan succeeds no market maker is asked for quotes.
SOLANA_SCAN_RPC=
# Usage scan interval (ms).
EXPOSURE_SYNC_MS=30000
# breezepocket program id; MMs whose hello reports another one are refused (4009).
PROGRAM_ID=BeytdpJYSGP1oFRxEiBLkSRGuW6HW3Pk9dqSZCuSteQ9
# Required: the USDC mint in the program's GlobalConfig (base58).
USDC_MINT=<usdc mint pubkey>
# Market-maker registrations and caps (docs/protocol.md §5): written by POST /mm/apply
# and the admin API, mode 0600. The directory is created if missing.
MM_REGISTRY_PATH=./data/mm-registry.json

# Auction window for POST /rfq (ms).
RFQ_TIMEOUT_MS=1000
# How long POST /sign waits for the MM's co-signature (ms).
SIGN_TIMEOUT_MS=10000
# Per-MM wait for market_request answers (ms).
MARKET_TIMEOUT_MS=2500
# Per-instance health poll interval (ms).
HEALTH_POLL_MS=5000
# GET /board cache TTL (ms).
BOARD_CACHE_MS=5000
# GET /expiries cache TTL (ms).
EXPIRIES_CACHE_MS=30000
# Broadcast co-signed transactions from the backend (true/false).
BROADCAST=true

# Faucet: off unless FAUCET_KEYPAIR points at the test-mint authority keypair
# (Solana CLI JSON, a 64-byte array). It pays the fees and must be the mint authority
# of the test USDC and of every listed asset's test mint.
FAUCET_KEYPAIR=
# Test USDC per claim.
FAUCET_AMOUNT_USDC=1000
# USD worth of a listed asset per claim (at the merged spot, 4 significant figures).
FAUCET_ASSET_USD=1000
# SOL airdropped with each faucet claim, best effort; 0 skips the airdrop.
FAUCET_SOL_AIRDROP=0.5
# One claim per wallet and token per this many ms.
FAUCET_COOLDOWN_MS=3600000

# Enables the admin API (GET /admin/mms, approve / reject / suspend / delete) with
# "Authorization: Bearer <token>". Empty disables it, and then nobody can be approved.
ADMIN_TOKEN=

# tracing filter, e.g. info or paytience_backend=debug.
RUST_LOG=info
