[Unit]
Description=PAYtience backend (market-maker quote aggregator)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/paytience/.env

[Service]
User=paytience
Group=paytience
WorkingDirectory=/opt/paytience
ExecStart=/opt/paytience/paytience-backend
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
