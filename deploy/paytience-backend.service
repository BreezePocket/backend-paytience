[Unit]
Description=PAYtience backend (market-maker quote aggregator)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/paytience/.env

[Service]
User=paytience
Group=paytience
WorkingDirectory=/opt/paytience
ExecStart=/opt/paytience/paytience-backend
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The market-maker registry (MM_REGISTRY_PATH) is the only thing the backend writes.
ReadWritePaths=/opt/paytience/data

[Install]
WantedBy=multi-user.target
